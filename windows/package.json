{
  "name": "coucou-windows",
  "private": true,
  "version": "0.6.5",
  "type": "module",
  "scripts": {
    "synthetic:build": "tsc --noEmit -p synthetic/tsconfig.json && vite build --config vite.synthetic.config.ts",
    "synthetic": "npm run synthetic:build && cargo run --offline --manifest-path synthetic/host/Cargo.toml --target-dir target/synthetic-host",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
